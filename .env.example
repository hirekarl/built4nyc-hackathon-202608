# EZStreet environment variables
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored;
# this file is the committed template and must never contain a real token.
#
#     cp .env.example .env.local
#
# The app runs correctly with NO environment variables set. Everything here is
# optional and only raises rate limits.

# ---------------------------------------------------------------------------
# SOCRATA_APP_TOKEN (optional)
# ---------------------------------------------------------------------------
# Raises NYC Open Data (Socrata) rate limits. Unauthenticated requests are
# throttled to a shared pool; a token gives this app its own allowance of
# roughly 1000 requests per rolling window.
#
# Register one (about 5 minutes, free):
#   https://data.cityofnewyork.us/profile/app_tokens
#
# Read server-side only, by all three adapters, and sent as the `X-App-Token`
# header when present:
#   src/lib/adapters/centerline.ts
#   src/lib/adapters/collisions.ts
#   src/lib/adapters/priority-zones.ts
#
# SECURITY: do NOT rename this with a `NEXT_PUBLIC_` prefix. That would inline
# the value into the client bundle and expose it to anyone who opens devtools.
# No browser code needs this token.
#
# Leave unset and every adapter still works — it simply sends no header.
SOCRATA_APP_TOKEN=

# ---------------------------------------------------------------------------
# Deploying to Vercel
# ---------------------------------------------------------------------------
# Local files are not uploaded. Add the variable to each environment you use:
#
#     vercel env add SOCRATA_APP_TOKEN development
#     vercel env add SOCRATA_APP_TOKEN preview
#     vercel env add SOCRATA_APP_TOKEN production
#
# Then pull it back down for local development if you like:
#
#     vercel env pull
#
# That writes `.vercel/.env.development.local`, which is also gitignored.
